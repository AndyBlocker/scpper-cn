# backend 配置示例
# 本文件此前不存在，新增变量以往靠口口相传。

# ---- 数据库与外部 API ----
DATABASE_URL=postgresql://user:pass@127.0.0.1:5434/scpper-cn
GRAPHQL_ENDPOINT=
GRAPHQL_TOKEN=

# ---- 站外通知投递（pm2: scpper-notify）----
# 跨库只读用户库，取「活跃的 QQ 通知绑定」。留空则投递器每轮直接跳过。
# 通常不必单独配置：services/userDirectory.ts 会自动加载 ../user-backend/.env。
USER_DATABASE_URL=

# 向 user-backend 回报投递结果（累计 failureCount、阈值处自动暂停失效渠道）。
# 必须与 user-backend/.env 的同名变量一致。**留空则渠道健康度永不更新、
# 失效的绑定永远不会被自动暂停**，投递器会对着删了机器人的用户无限重试。
NOTIFY_INTERNAL_KEY=

# qqbot 的对外接口。令牌必须与 qqbot/.env.prod 的 EXTERNAL_API_TOKEN 一致。
# 留空 = 不发送任何消息（fail closed）。
QQ_BOT_BASE_URL=http://127.0.0.1:8080
QQ_BOT_API_TOKEN=
QQ_BOT_TIMEOUT_MS=5000

# 冷启动闸门：**早于此刻的告警永不推送**。
# 生产库现存约 3.5 万条历史告警，不设这个值就会在首次上线时一次性推给所有人。
# 未设置时代码默认取「进程启动时刻」——安全的那一侧，但每次重启都会前移，
# 正式上线应显式写死一个 ISO 时间。
NOTIFY_DISPATCH_START_AT=

# 灰度名单：逗号分隔的 wikidotId，只给名单内的人推送。留空 = 不限制。
# 建议先放 3-5 个内测账号观察 48 小时，再逐步放开。
NOTIFY_QQ_ALLOWLIST=

# 回看窗口（小时）。超过这个时长还没推出去的告警会被放弃。
NOTIFY_LOOKBACK_HOURS=24
# 单用户单轮上限，超出的合并成「另有 N 条」
NOTIFY_CIRCUIT_USER_MAX=20
# 全局单轮上限。analyze --full 或 watermark 丢失会让告警量暴涨到上万条，
# 跳闸后需 `notify-dispatch --reset-circuit` 人工复位。
NOTIFY_CIRCUIT_GLOBAL_MAX=2000
# 单用户每日投递上限
NOTIFY_DAILY_LIMIT=40
# 摘要里「查看全部」链接的站点根地址。
# 必须是 **SCPper 前端**的域名（/account 页面由它提供），
# 不是 SCP 中文站本身 —— 填错的话链接会指到一个不存在的页面。
NOTIFY_SITE_BASE=https://scpper.mer.run

# ---- Wikidot 绑定校验（pm2: scpper-binding-verify）----
USER_BACKEND_BASE_URL=http://127.0.0.1:4455
INTERNAL_API_KEY=

# QQ 通知总开关（2026-07-30 起该功能暂时下线，默认关闭）
# 置 1 才会真正投递。恢复时**三处都要开**：
#   backend/.env（本文件，控制投递器）
#   user-backend/.env（控制绑定接口）
#   前端构建期 QQ_NOTIFY_ENABLED / 运行时 NUXT_PUBLIC_QQ_NOTIFY_ENABLED
# 只开其中一两处会出现「界面能绑定但永远收不到消息」这类半开状态。
QQ_NOTIFY_ENABLED=0
