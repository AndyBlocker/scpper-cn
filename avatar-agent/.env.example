# Avatar agent service environment variables (example)

NODE_ENV=production
PORT=3200
LOG_LEVEL=info

# Avatar cache
AVATAR_ROOT="/home/andyblocker/scpper-cn/.data/avatar-agent/avatars"
DEFAULT_AVATAR="/home/andyblocker/scpper-cn/avatar-agent/default-avatar.png"
AVATAR_TTL_DAYS=60
AVATAR_MAX_BYTES=2097152

# Wikidot avatar upstream
UPSTREAM_WIKIDOT="https://www.wikidot.com/avatar.php"
UPSTREAM_CLOUDFRONT_HOST="d2qhngyckgiutd.cloudfront.net"
UPSTREAM_ALLOWED_HOSTS="d2qhngyckgiutd.cloudfront.net,graph.facebook.com"
TIMEOUT_HEAD_MS=1500
TIMEOUT_GET_MS=5000
CLIENT_RATE_LIMIT_RPM=60
CF_RATE_LIMIT_RPS=5
WIKIDOT_RATE_LIMIT_RPS=0.5

# Page image worker
PAGE_IMAGE_WORKER_ENABLED=true
PAGE_IMAGE_DATABASE_URL="postgresql://username:password@127.0.0.1:5432/scpper-cn"
PAGE_IMAGE_ROOT="/home/andyblocker/scpper-cn/.data/page-images"
PAGE_IMAGE_WORKER_CONCURRENCY=1
PAGE_IMAGE_FETCH_DELAY_MS=2500
PAGE_IMAGE_IDLE_DELAY_MS=5000
PAGE_IMAGE_REQUEST_TIMEOUT_MS=10000
PAGE_IMAGE_RETRY_BASE_MS=60000
PAGE_IMAGE_RETRY_MAX_MS=3600000
PAGE_IMAGE_MAX_ATTEMPTS=24
PAGE_IMAGE_MAX_BYTES=5242880
PAGE_IMAGE_USER_AGENT="scpper-image-cache/1.0"
PAGE_IMAGE_STORAGE_MODE="hash"
PAGE_IMAGE_ALLOWED_HOSTS="*.wikidot.com,*.wdfiles.com,upload.wikimedia.org,images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com"
PAGE_IMAGE_BLOCKED_HOSTS="cdn.mer.run,cdn.mer.dev"
PAGE_IMAGE_VARIANT_ENABLED=true
PAGE_IMAGE_VARIANT_MAX_WIDTH=640
PAGE_IMAGE_VARIANT_QUALITY=72
