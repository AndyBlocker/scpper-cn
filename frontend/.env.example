# Frontend → BFF
BFF_BASE=/api
BFF_PROXY_TARGET=http://127.0.0.1:4396

# Optional request timing diagnostics
DEBUG_FETCH_TIMINGS=false
DEBUG_FETCH_MIN_DURATION_MS=0
SLOW_FETCH_THRESHOLD_MS=800

# 站内提醒阅读界面总开关（默认关闭）
# 关闭时隐藏铃铛、收件箱与设置入口，并停止前端预取；后端仍保留告警生成，
# 这样恢复界面后不会丢失暂停期间的历史。QQ 外部投递由下面的独立闸门阻止。
NOTIFICATIONS_ENABLED=0
# 已构建产物的运行时覆盖：
NUXT_PUBLIC_NOTIFICATIONS_ENABLED=false

# QQ 新绑定与消息投递总开关（默认关闭）
# 恢复时还必须同步开启 user-backend/.env、backend/.env，并单独启动投递器。
QQ_NOTIFY_ENABLED=0
# 已构建产物的运行时覆盖：
NUXT_PUBLIC_QQ_NOTIFY_ENABLED=false
