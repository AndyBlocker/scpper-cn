[Unit]
Description=syncer2 low-priority live-page revision full-source backfill

[Timer]
# 保留 :25/:55 的历史相位；它可与 L1 重叠，不再以看到 running 的 L0/L1 为整轮退出条件。
# revision-source 归 background 令牌桶（800/h，capacity 400），由配额等待而不是定时器相位让路。
OnCalendar=*-*-* *:25,55:00 Asia/Shanghai
AccuracySec=30s
Persistent=false
Unit=syncer2-job@revision-source-backfill.service

[Install]
WantedBy=timers.target
