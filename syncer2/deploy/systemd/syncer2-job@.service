[Unit]
Description=syncer2 single-run job (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# `current` 由 deploy/deploy 原子翻转。oneshot 已启动的进程继续使用旧 inode，
# 下一轮自然从新快照启动，不需要 restart，也绝不能从开发工作树直跑。
WorkingDirectory=%h/syncer2-releases/current
EnvironmentFile=%h/syncer2-releases/current/.env
Environment=PATH=%h/.nvm/versions/node/v22.17.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm --prefix %h/syncer2-releases/current run schedule:%i
# 未单列的轻量作业使用有限默认值；各生产实例在同目录的 drop-in 中按实测覆盖。
TimeoutStartSec=15min
TimeoutStopSec=30s
KillSignal=SIGTERM
Nice=10

# 调度只允许 timer 启动一次性短进程。禁止改成 PM2 restart_delay：正常退出也会累计
# restart 次数，快速失败循环最终把 app 打成 errored；这正是 v1 三个常驻 loop
# 2,388 次静默失败的病根。若改用 PM2，只能用 cron_restart + autorestart:false。
