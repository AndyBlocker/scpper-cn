{
  "name": "scpper-cn-syncer2",
  "version": "0.1.0",
  "description": "SCPper CN v2 采集层：wikidot 直连常驻源 + sitemap 发现通道（短进程 CLI，无常驻 loop）",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "check:sql-tuning": "node --import tsx/esm src/cli/check-sql-tuning.ts",
    "check:egress-capacity": "node --import tsx/esm src/cli/check-egress-capacity.ts",
    "build": "tsc",
    "test": "node --import tsx/esm --test --test-concurrency=1 'tests/**/*.test.ts'",
    "test:offline": "node --import tsx/esm --test tests/http.test.ts tests/parse.test.ts",
    "test:db": "node --import tsx/esm --test tests/db.test.ts",
    "test:gates": "node --import tsx/esm --test --test-concurrency=1 --test-reporter=spec tests/t5-vote-batch.test.ts tests/t6-role-permission.test.ts tests/t7-cursor-safety.test.ts",
    "test:t5": "node --import tsx/esm --test --test-reporter=spec tests/t5-vote-batch.test.ts",
    "test:t6": "node --import tsx/esm --test --test-reporter=spec tests/t6-role-permission.test.ts",
    "test:t7": "node --import tsx/esm --test --test-reporter=spec tests/t7-cursor-safety.test.ts",
    "sitemap:delta": "node --import tsx/esm src/cli/sitemap-scan.ts --mode delta",
    "sitemap:full": "node --import tsx/esm src/cli/sitemap-scan.ts --mode full",
    "sitemap:threads": "node --import tsx/esm src/cli/sitemap-scan.ts --mode threads",
    "sitemap:category": "node --import tsx/esm src/cli/sitemap-scan.ts --mode category",
    "sitemap:delta:dry": "node --import tsx/esm src/cli/sitemap-scan.ts --mode delta --dry-run",
    "tier1": "node --import tsx/esm src/cli/tier1-scan.ts",
    "tier1:sample": "node --import tsx/esm src/cli/tier1-scan.ts --dry-run --max-batches 2",
    "layer:l0": "node --import tsx/esm src/cli/incremental-scan.ts --layer l0",
    "layer:l1": "node --import tsx/esm src/cli/incremental-scan.ts --layer l1",
    "layer:l2": "node --import tsx/esm src/cli/sitemap-scan.ts --mode full --page-scan all",
    "resolve:pages": "node --import tsx/esm src/cli/resolve-pages.ts",
    "resolve:pages:dry": "node --import tsx/esm src/cli/resolve-pages.ts --dry-run --limit 5",
    "work:queue": "node --import tsx/esm src/cli/work-queue.ts --limit 50",
    "work:queue:probe": "node --import tsx/esm src/cli/work-queue.ts --probe-only",
    "votes:replay": "node --import tsx/esm src/cli/vote-replay.ts",
    "meta:page-scan-maintain": "node --import tsx/esm src/cli/page-scan-maintenance.ts",
    "meta:oldest-pending": "node --import tsx/esm src/cli/oldest-pending.ts",
    "view:migrate": "node --import tsx/esm src/cli/view-migrate.ts",
    "schedule:l0": "node --import tsx/esm src/cli/incremental-scan.ts --layer l0 --concurrency 3 --max-runtime-sec 120 --amc-probe skip --proxy-check warn",
    "schedule:l1": "node --import tsx/esm src/cli/incremental-scan.ts --layer l1 --concurrency 5 --max-runtime-sec 180 --amc-probe skip --proxy-check warn",
    "schedule:l2": "node --import tsx/esm src/cli/sitemap-scan.ts --mode full --page-scan all --concurrency 4 --max-runtime-sec 240 --proxy-check warn",
    "schedule:l3": "node --import tsx/esm src/cli/tier1-scan.ts --concurrency 5 --max-runtime-sec 1500 --amc-probe require --proxy-check warn",
    "schedule:resolve-pages": "node --import tsx/esm src/cli/resolve-pages.ts --limit 50 --concurrency 2 --max-runtime-sec 120 --amc-probe skip --proxy-check warn",
    "schedule:work-queue": "node --import tsx/esm src/cli/work-queue.ts --limit 50 --concurrency 4 --max-runtime-sec 360 --amc-probe require --proxy-check warn",
    "schedule:forum-discovery": "node --import tsx/esm src/cli/forum-incremental.ts --max-pages 40 --max-runtime-sec 330",
    "schedule:forum-audit": "node --import tsx/esm src/cli/sitemap-scan.ts --mode threads --page-scan none --concurrency 4 --max-runtime-sec 300 --proxy-check warn",
    "schedule:forum-consume": "node --import tsx/esm src/cli/forum-scan.ts --limit 50 --concurrency 4 --max-runtime-sec 360 --amc-probe require --proxy-check warn",
    "schedule:image-ingest": "node --import tsx/esm src/cli/image-ingest.ts --limit 120 --max-runtime-sec 300 --external-interval-ms 3000 --asset-root /home/andyblocker/scpper-cn/.data/page-images",
    "schedule:revision-source-backfill": "node --import tsx/esm src/cli/revision-source-backfill.ts --limit 300 --seed-limit 5000 --delay-ms 250 --max-runtime-sec 200 --minimum-free-gb 100 --amc-probe require --proxy-check warn",
    "schedule:reconcile": "node --import tsx/esm src/cli/reconcile.ts --mode all --triangle-pages 10 --concurrency 2 --max-runtime-sec 720 --amc-probe require --proxy-check warn",
    "schedule:page-scan-maintenance": "node --import tsx/esm src/cli/page-scan-maintenance.ts --max-runtime-sec 60",
    "schedule:oldest-pending": "node --import tsx/esm src/cli/oldest-pending.ts --max-runtime-sec 30",
    "schedule:project": "node --import tsx/esm src/cli/project.ts --exclude-deleted-pages --max-runtime-sec 120",
    "images:backfill": "node --import tsx/esm src/cli/image-backfill.ts",
    "images:import-v1": "node --import tsx/esm src/cli/image-asset-import.ts",
    "images:ingest": "node --import tsx/esm src/cli/image-ingest.ts",
    "images:sample-refresh": "node --import tsx/esm src/cli/image-sample-refresh.ts",
    "images:audit": "node --import tsx/esm src/cli/image-audit.ts",
    "forum:scan": "node --import tsx/esm src/cli/forum-scan.ts --limit 20",
    "forum:probe": "node --import tsx/esm src/cli/forum-scan.ts --probe-only",
    "forum:links:dry": "node --import tsx/esm src/cli/forum-link-backfill.ts",
    "forum:links": "node --import tsx/esm src/cli/forum-link-backfill.ts --execute",
    "project": "node --import tsx/esm src/cli/project.ts",
    "project:rebuild": "node --import tsx/esm src/cli/project.ts --rebuild",
    "project:catch-up": "node --import tsx/esm src/project/catchUp.ts",
    "project:compare-v1": "node --import tsx/esm src/project/compareUserStats.ts",
    "reconcile": "node --import tsx/esm src/cli/reconcile.ts",
    "reconcile:qq": "node --import tsx/esm src/cli/reconcile.ts --qq-summary",
    "qq:report": "node --import tsx/esm src/cli/qq-report.ts",
    "prisma:pull": "./prisma/pull.sh",
    "prisma:check": "./prisma/pull.sh --check",
    "gate:load-v1": "./checks/load_v1_identity.sh",
    "gate:backfill": "psql \"$SYNCER2_DATABASE_URL\" -f checks/backfill_finalize.sql",
    "gate:backfill:dry": "psql \"$SYNCER2_DATABASE_URL\" -v gate_mode=dryrun -f checks/backfill_finalize.sql",
    "backfill:s1:dry": "node --import tsx/esm src/backfill/s1.ts --dry-run",
    "backfill:s1": "node --import tsx/esm src/backfill/s1.ts --execute",
    "backfill:s1:top-up:dry": "node --import tsx/esm src/backfill/s1-topup.ts --dry-run",
    "backfill:s1:top-up": "node --import tsx/esm src/backfill/s1-topup.ts --execute",
    "backfill:s3:live-dry": "node --import tsx/esm src/backfill/s3-live-remediate.ts",
    "backfill:s3:deleted-signoff": "node --import tsx/esm src/backfill/s3-deleted-signoff.ts",
    "backfill:s3:dry": "node --import tsx/esm src/backfill/s3.ts --dry-run",
    "backfill:s3": "node --import tsx/esm src/backfill/s3.ts --execute",
    "backfill:s2:dry": "node --import tsx/esm src/backfill/s2.ts --dry-run",
    "backfill:s2": "node --import tsx/esm src/backfill/s2.ts --execute",
    "backfill:s456:dry": "node --import tsx/esm src/backfill/s456.ts --dry-run",
    "backfill:s456": "node --import tsx/esm src/backfill/s456.ts --execute",
    "backfill:forum:dry": "node --import tsx/esm src/backfill/forum.ts --dry-run",
    "backfill:forum": "node --import tsx/esm src/backfill/forum.ts --execute",
    "revision-source:pilot": "node --import tsx/esm src/cli/revision-source-backfill.ts --pilot --delay-ms 250 --minimum-free-gb 100 --amc-probe require --proxy-check warn",
    "revision-source:backfill": "node --import tsx/esm src/cli/revision-source-backfill.ts --minimum-free-gb 100"
  },
  "dependencies": {
    "@ukwhatn/wikidot": "^4.3.1",
    "cheerio": "^1.2.0",
    "commander": "^14.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.16.3",
    "tsx": "^4.21.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.16.0",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
