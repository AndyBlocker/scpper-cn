# ─────────────────────────────────────────────────────────────────────────────
# syncer2 —— v2 采集层配置
# 复制为 .env 后填写。所有变量都有 SYNCER2_ 前缀，避免与 v1 syncer 的 .env 串味。
# ─────────────────────────────────────────────────────────────────────────────

# v2 独立库（scpper-v2）。注意：这是 syncer2 唯一写入的库。
# 主库 scpper-cn 在并行期是只读的，syncer2 不持有它的连接串。
SYNCER2_DATABASE_URL="postgresql://user:pass@localhost:5434/scpper-v2"

# M10 parity 模式才需要。必须指向 v1 主库 scpper-cn；代码会二次核对库名，
# 且每次查询都包在 BEGIN READ ONLY 中，禁止任何写操作。
# 只读参数是迁移入口的硬关卡，禁止删除；代码还会核对服务端 session 的 read-only 状态。
# SYNCER2_V1_DATABASE_URL="postgresql://user:pass@localhost:5434/scpper-cn?options=-c%20default_transaction_read_only%3Don"

# 站点根（sitemap / 整页 GET 的 base）。canonical URL 在 wikidot 侧一律是 http://，
# 但取 sitemap 走 https 更稳；slug 归一化时协议与域名都会被剥掉，所以两者等价。
SYNCER2_SITE_BASE_URL="https://scp-wiki-cn.wikidot.com"

# ── 出口 ─────────────────────────────────────────────────────────────────────
# mihomo 负载均衡端口。留空 = 直连本机出口（不推荐：wikidot 侧封禁面是共享订阅节点，
# 本机 IP 不是 fallback）。
SYNCER2_HTTP_PROXY="http://127.0.0.1:7891"

# ── 请求头契约（实测硬性要求，缺一即拒绝启动，见 src/http/client.ts）────────────
#   · 空 User-Agent → WAF 直接 HTTP 503 空体（实测 0 B）
#   · AMC POST 缺 Referer → TCP 连接重置（实测 0/15 成功）
# 值本身不敏感（实测任意 Referer 都放行，只校验存在性），但**不能为空**。
#
# 注意这两个变量的空值语义与 SYNCER2_HTTP_PROXY 相反：
#   · 整行删除 / 不设置 → 用代码里的默认值（可以）
#   · 设置成空串或纯空白 → **直接报错拒绝启动**，不回落默认值
# 理由：如果"设成空"能静默回落，assertHeaders() 这道自检就永远无法触发，
# 而它保护的恰恰是"头被弄丢"这个场景（v1 的 https-fix.ts 猴补丁 fetch 就是高危点）。
SYNCER2_USER_AGENT="scpper-cn-syncer2/0.1 (+https://scpper.cn; contact: me@mer.dev)"
SYNCER2_REFERER="https://scp-wiki-cn.wikidot.com/"

# ── HTTP 护栏 ────────────────────────────────────────────────────────────────
# 单请求超时（毫秒）
SYNCER2_HTTP_TIMEOUT_MS=30000
# 可重试错误（500/502/504、非重置类传输错）的最大尝试次数
SYNCER2_HTTP_MAX_ATTEMPTS=3
# 连续 N 次 HTTP 503 即熔断整进程（503 的正确响应是停手，不是重发）
SYNCER2_HTTP_503_BREAKER=5
# 连续 N 次传输重置即熔断（实测基线传输失败率 1–3%，连续多次说明出口坏了）
SYNCER2_HTTP_RESET_BREAKER=5
# 同时打开的 sitemap 请求数（4 个 page sitemap 全量时生效）。保持个位数。
SYNCER2_HTTP_CONCURRENCY=2

# ── L0/L1 分层增量 ────────────────────────────────────────────────────────────
# L0 内容编辑与 L1 投票全站扫描必须同频。先以 30 分钟上线；观察一周后可一起改成 15。
# PM2 配置直接读取本项；systemd 需同步选择 deploy/systemd timer 的 30m/15m OnCalendar。
SYNCER2_INCREMENTAL_FREQUENCY_MINUTES=30
# L0 每轮查询 updated_at="last N hours"。2h 对 30m 周期是 4 倍、对 15m 是 8 倍重叠。
SYNCER2_L0_WINDOW_HOURS=2

# ── 本地状态 ─────────────────────────────────────────────────────────────────
# 短进程之间靠这个目录传递上一轮 sitemap 快照。可安全删除（删掉只会退化为 bootstrap 轮）。
SYNCER2_STATE_DIR="./state"

# ── absence（删除推断）门控 ───────────────────────────────────────────────────
# full 轮枚举数 / 上一轮基线 低于该比例 → 本轮不允许产生任何 confirm_deleted
SYNCER2_MIN_ENUMERATED_RATIO=0.98
# 单轮 absent 页数超过该阈值 → 批量熔断，一个 confirm_deleted 都不下，只告警
SYNCER2_ABSENCE_CIRCUIT=500

# M8 待产品裁决：user_page/user_stats 是否纳入已删页作品。
# 默认 false 与 v1 一致；两种口径都可运行，切换后 projector 会完整刷新这两张表。
SYNCER2_PROJECT_INCLUDE_DELETED_PAGES=false

# ── 出口归因（TODO #12 → meta.ingest_run.exit_ip_stats）───────────────────────
# 49 节点轮换池、无 fallback、无健康检查。不记出口就无法回答"是哪几个节点坏了"。
#
# 两个信源，可信度不同（详见 src/http/egress.ts 文件头）：
#   1) IP 回显探针：给出「这一条探针连接」的真实出口 IP。实测**每次探针都换 IP**，
#      所以它衡量的是**池构成**，不是相邻那个 wikidot 请求的出口。
#   2) mihomo 本地控制器 /connections：给出每条活连接的 chains[0] = 承载节点名
#      （按连接的真值），且是本机 HTTP、零 wikidot 成本 —— 定位坏节点主要看它。
#
# 这三个变量的空值语义与 UA/Referer **相反**：空 = 显式关闭（合法运维决定），
# 因为归因是可选监控；而 UA/Referer 是站点契约，关掉等于 100% 503。
SYNCER2_EXIT_IP_PROBE_URL="http://api.ipify.org"
# 每 N 个 wikidot 请求探一次（0 = 只在启动与失败时探）。刻意不是每请求都探。
SYNCER2_EXIT_IP_PROBE_EVERY=25
# 单轮探针总数上限（含启动探针与失败补探）
SYNCER2_EXIT_IP_PROBE_MAX=8
# mihomo 控制器（本机）。留空 = 关闭节点归因
SYNCER2_MIHOMO_API="http://127.0.0.1:9090"

# ── 启动自检 #3（TODO #13）────────────────────────────────────────────────────
# AMC POST 契约探针：require | warn | skip。
# 不设置 = 按采集通道自动判定（sitemap / 整页 GET 都是纯 GET ⇒ skip；
# ListPages / WhoRated / 修订等走 AMC 的通道 ⇒ require）。
# 实测：POST /ajax-module-connector.php 缺 Referer → TCP reset（0/15 成功），
# 且这条契约未文档化、值任意只校验存在性 —— 规则集正在被主动调整，所以要真打一个 POST。
#SYNCER2_AMC_PROBE=require
# 代理健康探测：require | warn | skip（默认 warn）。
# 抓的是"代理静默回落直连、我们用家宽 IP 高频抓站"这种**不报错的**故障：
# 判据 (a) mihomo chains[0]=DIRECT；(b) 经代理与直连取到同一个出口 IP。
SYNCER2_PROXY_CHECK=warn

# ── 未消化数据队列（TODO #14）─────────────────────────────────────────────────
# meta.pending_page 冷启动闸：待解析 slug 超过该值时 resolve-pages 拒绝自动跑
#（空库有 3.6 万条待解析，一页一个整页 GET = 3.6 万请求，与 field-matrix 的
# "绝不为全站 36k 页各打一次 GET"直接冲突 —— 冷启动该走 Phase 2 批量回填）。
# 要强行跑：resolve-pages --force-cold-start
SYNCER2_PENDING_COLD_START=2000

# ── Phase 2 回填收尾 gate（TODO #7）───────────────────────────────────────────
# 只被 migrations/checks/load_v1_identity.sh 读，用来把 v1 身份 id 单向 COPY 进
# meta.v1_identity。**采集层运行时不读这两个变量** —— 并行期主库只读，
# src/ 下的代码不该有能力碰到它们（所以它们不进 src/config.ts）。
# 也可以不设，改用 CLI 参数 --v1-database-url / --user-database-url。
#
# ⚠ 载入器对 v1 只发 SELECT / COPY TO STDOUT；脚本内有目标库黑名单 + 源库白名单两道闸。
#V1_DATABASE_URL="postgresql://user:pass@localhost:5434/scpper-cn"
#USER_DATABASE_URL="postgresql://user:pass@localhost:5434/scpper_user"
